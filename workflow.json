{
  "name": "Telegram to Google Calendar",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{$env.GEMINI_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { contents: [{ parts: [{ text: 'Extract a calendar event from this Telegram message. Return ONLY valid JSON with keys: action, title, start, end, timezone, description, location, clarification. Use ISO 8601 timestamps. Current time is ' + $now.toISO() + '. User timezone is UTC unless the message specifies another timezone. If the message is ambiguous or missing a date/time, set action to clarification and put one concise question in clarification. Otherwise set action to create. Message: ' + ($('Telegram Trigger').first().json.message?.text || '') }] }] } }}",
        "options": {}
      },
      "id": "parse-event",
      "name": "Parse Event with Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.candidates?.[0]?.content?.parts?.[0]?.text || '';\\nconst cleaned = raw.replace(/^```json\\\\s*/i, '').replace(/\\\\s*```$/i, '').trim();\\nlet event;\\ntry { event = JSON.parse(cleaned); } catch (error) { throw new Error(`Gemini returned invalid JSON: ${error.message}`); }\\nconst chatId = $('Telegram Trigger').first().json.message?.chat?.id;\\nif (!chatId) throw new Error('Telegram message did not include a chat id');\\nreturn [{ json: { ...event, chatId } }];"
      },
      "id": "normalize-event",
      "name": "Normalize Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.action}}",
              "operation": "equals",
              "value2": "create"
            }
          ]
        }
      },
      "id": "route-action",
      "name": "Create or Clarify",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "primary"
        },
        "start": "={{$json.start}}",
        "end": "={{$json.end}}",
        "additionalFields": {
          "summary": "={{$json.title}}",
          "description": "={{$json.description || ''}}",
          "location": "={{$json.location || ''}}"
        }
      },
      "id": "create-calendar-event",
      "name": "Create Google Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        1200,
        220
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{$('Normalize Event').first().json.chatId}}",
        "text": "={{`Created: ${$('Normalize Event').first().json.title}\\n${$json.htmlLink || ''}`}}"
      },
      "id": "confirm-created",
      "name": "Confirm Created Event",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1440,
        220
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{$json.chatId}}",
        "text": "={{$json.clarification}}"
      },
      "id": "ask-clarification",
      "name": "Ask Clarifying Question",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1200,
        420
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Parse Event with Gemini",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Event with Gemini": {
      "main": [
        [
          {
            "node": "Normalize Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Event": {
      "main": [
        [
          {
            "node": "Create or Clarify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create or Clarify": {
      "main": [
        [
          {
            "node": "Create Google Calendar Event",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ask Clarifying Question",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Google Calendar Event": {
      "main": [
        [
          {
            "node": "Confirm Created Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "telegram-calendar-v1"
}
